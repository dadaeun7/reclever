FROM python:3.12-slim-bookworm

WORKDIR /app

# 필수 리눅스 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends gcc build-essential libgl1 && rm -rf /var/lib/apt/lists/*

# 의존성만 복사 후 설치 (이러면 requirements.txt가 바뀔 때만 빌드가 돔)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# EasyOCR 모델 선다운로드 (지정 경로 고정)
# ENV EASYOCR_MODULE_PATH=/root/.EasyOCR
# RUN python3 -c "import easyocr; reader = easyocr.Reader(['ko', 'en'], gpu=False)"

# 2. Sentence-Transformers 모델 선다운로드 (Hugging Face 기본 캐시 경로에 저장됨)
# RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('snunlp/KR-SBERT-V40K-klueNLI-augSTS')"

# [핵심] COPY . . 를 하지 않고, 소스 코드는 컴포즈 볼륨으로 저장.
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host=0.0.0.0", "--port=8000", "--reload"]