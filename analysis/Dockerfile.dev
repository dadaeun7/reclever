FROM python:3.12-slim-bookworm

WORKDIR /app

# 필수 리눅스 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends gcc build-essential libgl1 && rm -rf /var/lib/apt/lists/*

# 의존성만 복사 후 설치 (이러면 requirements.txt가 바뀔 때만 빌드가 돔)
COPY analysis/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY proto/ /proto/
COPY analysis/ .

RUN python -m grpc_tools.protoc \
    -I/proto \
    --python_out=. \
    --grpc_python_out=. \
    /proto/java_python_product_analysist.proto

EXPOSE 50051
CMD sh -c "python -m grpc_tools.protoc -I/proto --python_out=. --grpc_python_out=. /proto/java_python_product_analysist.proto && python /app/app/main.py"